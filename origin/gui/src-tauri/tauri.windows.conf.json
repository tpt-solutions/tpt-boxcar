{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/v2/tooling/cli/schema.json",
  "productName": "TPT Origin",
  "identifier": "com.tpt-cloud-native.origin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "title": "TPT Origin",
    "windows": [
      {
        "title": "TPT Origin — Local Sandbox",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "startMenuShortcut": true,
        "desktopShortcut": true
      },
      "msi": {
        "upgradeCode": "0C36DE65-C9A7-4E7F-9D1F-B2C5E5A5D5E3"
      }
    }
  }
}

package tpt:tether@0.1.0;

/// Shared value/record/error types used by both the `data` and `kv` interfaces.
interface types {
    /// A single cell value. Mirrors the subset of `serde_json::Value` that the
    /// wire drivers actually produce/consume; JSON objects/arrays are not
    /// representable at the WIT boundary and are not needed by any driver today.
    variant value {
        %null,
        %bool(bool),
        int(s64),
        float(f64),
        text(string),
    }

    /// A tabular query result: column names plus a flat list of cell values.
    record query-row {
        columns: list<string>,
        values: list<value>,
    }

    /// Typed error boundary. Internal driver code keeps using `anyhow::Error`;
    /// this variant is only what crosses the host/guest component boundary.
    variant tether-error {
        not-connected,
        driver-error(string),
        unsupported-operation(string),
        timeout,
    }
}

/// Query/execute/transaction operations, backed by whichever `WireDriver`
/// (Postgres, MySQL, Redis) the host has connected.
interface data {
    use types.{value, query-row, tether-error};

    query: func(sql: string, params: list<value>) -> result<query-row, tether-error>;
    execute: func(sql: string, params: list<value>) -> result<u64, tether-error>;

    /// A transaction handle. Guests call `query`/`execute` against it, then
    /// must call exactly one of `commit`/`rollback` to consume it.
    resource transaction {
        query: func(sql: string, params: list<value>) -> result<query-row, tether-error>;
        execute: func(sql: string, params: list<value>) -> result<u64, tether-error>;
        commit: static func(self: transaction) -> result<_, tether-error>;
        rollback: static func(self: transaction) -> result<_, tether-error>;
    }

    begin-transaction: func() -> result<transaction, tether-error>;
}

/// Key-value operations. Only meaningful when the host driver is Redis;
/// calling these against a non-KV-capable driver returns `unsupported-operation`.
interface kv {
    use types.{tether-error};

    get: func(key: string) -> result<option<string>, tether-error>;
    set: func(key: string, value: string) -> result<_, tether-error>;
    del: func(key: string) -> result<u64, tether-error>;
    expire: func(key: string, ttl-secs: u64) -> result<bool, tether-error>;
}

/// Publish/subscribe, backed by Redis. Only meaningful when the host driver
/// is Redis; calling these against a non-pub/sub-capable driver returns
/// `unsupported-operation`.
///
/// A long-lived subscription doesn't map onto WIT's synchronous call/return
/// shape, so this is a *polling* API rather than a blocking stream: opening
/// a `subscription` starts a real dedicated connection to the backing Redis
/// server (issuing `SUBSCRIBE`) whose incoming `message`/`pmessage` frames
/// are drained by the host into an in-memory queue in the background;
/// `subscription.poll` is a non-blocking pop against that queue, returning
/// `none` immediately when nothing is buffered. Guests are expected to call
/// `poll` on a loop/timer rather than assume it blocks until a message
/// arrives.
interface pubsub {
    use types.{tether-error};

    record message {
        channel: string,
        payload: string,
    }

    resource subscription {
        /// Opens a new subscription, connecting and issuing `SUBSCRIBE` for
        /// `channels` (may be empty — channels can be added later via
        /// `subscribe`).
        open: static func(channels: list<string>) -> result<subscription, tether-error>;
        /// Adds more channels to this subscription.
        subscribe: func(channels: list<string>) -> result<_, tether-error>;
        /// Removes channels from this subscription.
        unsubscribe: func(channels: list<string>) -> result<_, tether-error>;
        /// Non-blocking: returns the next buffered message, if any.
        poll: func() -> result<option<message>, tether-error>;
    }

    /// One-shot publish; not part of the `subscription` resource since a
    /// publisher doesn't need one open. Returns the number of subscribers
    /// that received the message (Redis's own `PUBLISH` return value).
    publish: func(channel: string, payload: string) -> result<u64, tether-error>;
}

/// The world a Wasm guest imports to talk to Tether.
///
/// `run` is an example entry point exported by `tether/examples/wit-guest-demo`
/// so the host (and `component_test.rs`) has something to call; it is not part
/// of the core `tpt:tether` interface contract, just this demo world's shape.
world tether-guest {
    import data;
    import kv;
    import pubsub;

    export run: func() -> string;
}
